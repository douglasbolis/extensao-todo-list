{
  "name": "extensao-todo-list",
  "version": "1.0.0",
  "description": "Todo-List usando Spec-Driven Development e Arquitetura MVC",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "install:api": "npm install --prefix apps/api",
    "install:web": "npm install --prefix apps/web",
    "install:all": "npm install --prefix apps/api && npm install --prefix apps/web",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "dependencies": {
    "express": "^4.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.3.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "jsdom": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsc-watch": "^6.0.4",
    "typescript": "^5.0.0",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
